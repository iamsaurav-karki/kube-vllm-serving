# Copy to terraform.tfvars. The copied file is ignored by Git.
# Never put a private SSH key or application secret in this file.

location       = "eastasia"
admin_username = "sauravkarki"

# Discover with: curl -fsS https://api.ipify.org && printf '/32\n'
admin_cidr = "203.0.113.10/32"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Spot is the cost-minimized default. Set false if capacity is unavailable or
# uninterrupted benchmark sessions matter more than the approximately 80% saving.
gpu_use_spot       = true
gpu_spot_max_price = 1.50

tags = {
  owner       = "sauravkarki"
  auto_delete = "manual"
}
